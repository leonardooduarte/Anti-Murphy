{
  "$defs": {
    "ActionInfo": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "requested_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Requested Us",
          "type": "integer"
        },
        "effective_us": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Us"
        }
      },
      "required": [
        "action_id",
        "label",
        "requested_us"
      ],
      "title": "ActionInfo",
      "type": "object"
    },
    "BranchSummary": {
      "additionalProperties": false,
      "properties": {
        "feasible": {
          "enum": [
            "feasible",
            "infeasible",
            "unverified"
          ],
          "title": "Feasible",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ConstraintCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "total_cost_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Cost Cents"
        },
        "sla_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sla Pct"
        },
        "makespan_us": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Makespan Us"
        },
        "late_orders": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Late Orders"
        }
      },
      "required": [
        "feasible"
      ],
      "title": "BranchSummary",
      "type": "object"
    },
    "BranchTimeline": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Branch Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "scenario_label": {
          "minLength": 1,
          "title": "Scenario Label",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "engine_native",
            "trace_derived",
            "synthetic_fixture"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "model_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Sha256",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/SimulationSnapshot"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventDelta"
          },
          "title": "Events",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/BranchSummary"
        }
      },
      "required": [
        "branch_id",
        "run_id",
        "scenario_label",
        "provenance",
        "model_sha256",
        "seed",
        "summary"
      ],
      "title": "BranchTimeline",
      "type": "object"
    },
    "CommonHistory": {
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "enum": [
            "engine_native",
            "trace_derived",
            "synthetic_fixture"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/SimulationSnapshot"
          },
          "minItems": 1,
          "title": "Keyframes",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventDelta"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "provenance",
        "keyframes"
      ],
      "title": "CommonHistory",
      "type": "object"
    },
    "ConstraintCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "operator_skill",
            "buffer_capacity",
            "sequence_setup",
            "machine_capacity",
            "worker_capacity",
            "budget",
            "other"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "title": "ConstraintCheck",
      "type": "object"
    },
    "EventDelta": {
      "additionalProperties": false,
      "description": "Upserts absolutos (idempotentes), ordenados por seq no dominio de cada ramo.",
      "properties": {
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "time_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Time Us",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "queue_enter",
            "queue_leave",
            "operation_start",
            "operation_pause",
            "operation_resume",
            "operation_finish",
            "outage_start",
            "outage_end",
            "resource_changed",
            "setup_start",
            "setup_finish",
            "order_completed",
            "action_applied",
            "model_blocked"
          ],
          "title": "Kind",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "station_upserts": {
          "additionalProperties": {
            "$ref": "#/$defs/StationState"
          },
          "title": "Station Upserts",
          "type": "object"
        },
        "unit_upserts": {
          "additionalProperties": {
            "$ref": "#/$defs/UnitState"
          },
          "title": "Unit Upserts",
          "type": "object"
        },
        "order_upserts": {
          "additionalProperties": {
            "$ref": "#/$defs/OrderState"
          },
          "title": "Order Upserts",
          "type": "object"
        }
      },
      "required": [
        "seq",
        "time_us",
        "kind"
      ],
      "title": "EventDelta",
      "type": "object"
    },
    "FactoryDefinition": {
      "additionalProperties": false,
      "properties": {
        "stations": {
          "additionalProperties": {
            "$ref": "#/$defs/StationDefinition"
          },
          "title": "Stations",
          "type": "object"
        },
        "orders": {
          "additionalProperties": {
            "$ref": "#/$defs/OrderDefinition"
          },
          "title": "Orders",
          "type": "object"
        }
      },
      "required": [
        "stations",
        "orders"
      ],
      "title": "FactoryDefinition",
      "type": "object"
    },
    "FlowEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "waypoints": {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "title": "Waypoints",
          "type": "array"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "FlowEdge",
      "type": "object"
    },
    "ForkPoint": {
      "additionalProperties": false,
      "description": "Ultimo seq comum, horario de separacao logica; nao precisa existir evento nesse horario.",
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "time_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Time Us",
          "type": "integer"
        },
        "reason": {
          "default": "decision_boundary",
          "enum": [
            "decision_boundary",
            "intervention_requested"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "time_us"
      ],
      "title": "ForkPoint",
      "type": "object"
    },
    "IncidentDefinition": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "station_id": {
          "minLength": 1,
          "title": "Station Id",
          "type": "string"
        },
        "start_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        },
        "planned_end_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Planned End Us",
          "type": "integer"
        }
      },
      "required": [
        "incident_id",
        "station_id",
        "start_us",
        "planned_end_us"
      ],
      "title": "IncidentDefinition",
      "type": "object"
    },
    "OrderDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "due_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Due Us",
          "type": "integer"
        },
        "route_station_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Route Station Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "quantity",
        "due_us",
        "route_station_ids"
      ],
      "title": "OrderDefinition",
      "type": "object"
    },
    "OrderState": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "completed_units": {
          "minimum": 0,
          "title": "Completed Units",
          "type": "integer"
        },
        "completion_us": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Us"
        }
      },
      "required": [
        "id",
        "completed_units"
      ],
      "title": "OrderState",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "SimulationSnapshot": {
      "additionalProperties": false,
      "description": "Estado completo APOS o evento seq; seq=0 corresponde ao inicio da rodada.",
      "properties": {
        "branch_id": {
          "enum": [
            "common",
            "A",
            "B"
          ],
          "title": "Branch Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "time_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Time Us",
          "type": "integer"
        },
        "stations": {
          "additionalProperties": {
            "$ref": "#/$defs/StationState"
          },
          "title": "Stations",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "$ref": "#/$defs/UnitState"
          },
          "title": "Units",
          "type": "object"
        },
        "orders": {
          "additionalProperties": {
            "$ref": "#/$defs/OrderState"
          },
          "title": "Orders",
          "type": "object"
        }
      },
      "required": [
        "branch_id",
        "seq",
        "time_us",
        "stations",
        "units",
        "orders"
      ],
      "title": "SimulationSnapshot",
      "type": "object"
    },
    "StationDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "machine_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Machine Ids",
          "type": "array"
        },
        "required_skills": {
          "items": {
            "type": "string"
          },
          "title": "Required Skills",
          "type": "array"
        },
        "buffer_capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Buffer Capacity"
        },
        "x": {
          "description": "Posicao visual, nao distancia fisica",
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Posicao visual, nao distancia fisica",
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "machine_ids",
        "x",
        "y"
      ],
      "title": "StationDefinition",
      "type": "object"
    },
    "StationState": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "idle",
            "running",
            "down",
            "blocked",
            "setup"
          ],
          "title": "Status",
          "type": "string"
        },
        "machine_capacity": {
          "minimum": 0,
          "title": "Machine Capacity",
          "type": "integer"
        },
        "workers_available": {
          "minimum": 0,
          "title": "Workers Available",
          "type": "integer"
        },
        "busy_slots": {
          "minimum": 0,
          "title": "Busy Slots",
          "type": "integer"
        },
        "queue_unit_ids": {
          "items": {
            "type": "string"
          },
          "title": "Queue Unit Ids",
          "type": "array"
        },
        "processing_unit_ids": {
          "items": {
            "type": "string"
          },
          "title": "Processing Unit Ids",
          "type": "array"
        },
        "paused_unit_ids": {
          "items": {
            "type": "string"
          },
          "title": "Paused Unit Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "status",
        "machine_capacity",
        "workers_available",
        "busy_slots",
        "queue_unit_ids"
      ],
      "title": "StationState",
      "type": "object"
    },
    "Topology": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/FlowEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "transport_semantics": {
          "const": "logical_instantaneous",
          "default": "logical_instantaneous",
          "title": "Transport Semantics",
          "type": "string"
        }
      },
      "title": "Topology",
      "type": "object"
    },
    "UnitState": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "order_id": {
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "route_step": {
          "minimum": 0,
          "title": "Route Step",
          "type": "integer"
        },
        "station_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Station Id"
        },
        "machine_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "phase": {
          "enum": [
            "unreleased",
            "queued",
            "processing",
            "paused",
            "completed",
            "blocked"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "id",
        "order_id",
        "route_step",
        "phase"
      ],
      "title": "UnitState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "time_unit": {
      "const": "simulated_microsecond",
      "default": "simulated_microsecond",
      "title": "Time Unit",
      "type": "string"
    },
    "time_origin": {
      "const": "simulation_start",
      "default": "simulation_start",
      "title": "Time Origin",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/FactoryDefinition"
    },
    "topology": {
      "$ref": "#/$defs/Topology"
    },
    "incident": {
      "$ref": "#/$defs/IncidentDefinition"
    },
    "fork": {
      "$ref": "#/$defs/ForkPoint"
    },
    "common_history": {
      "$ref": "#/$defs/CommonHistory"
    },
    "branch_A": {
      "$ref": "#/$defs/BranchTimeline"
    },
    "branch_B": {
      "$ref": "#/$defs/BranchTimeline"
    }
  },
  "required": [
    "experiment_id",
    "definition",
    "topology",
    "incident",
    "fork",
    "common_history",
    "branch_A",
    "branch_B"
  ],
  "title": "ComparisonBundle",
  "type": "object"
}