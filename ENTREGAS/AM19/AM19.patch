+/* ANTI-MURPHY / INTERFACE EDITORIAL
+   Estrutura orientada a operação, sem slogans e sem camada de dashboard adicional. */
+:root{--ink:#1D292D;--black:#142226;--coal:#1D292D;--panel:#EDF0ED;--edge:#c7d2cf;--mint:#267e67;
+--orange:#FF681B;--ivory:#F7F7F3;--muted:#5a7071;--line:#d4deda}
+html,body{background:#F7F7F3;color:#1D292D;font-family:"Segoe UI",Arial,sans-serif}
+#app{background:#F7F7F3;min-height:900px;border:0;border-radius:0;box-shadow:none}
+.mast{padding:14px 29px;background:#F7F7F3;border-bottom:1px solid #c5cfca;gap:16px}
+.brand{color:#1D292D;font-size:13px;letter-spacing:.45px;font-weight:750}
+.brand img{height:34px;max-height:34px;max-width:176px;object-fit:contain}
+.brand-sub{color:#506466;font-size:11px;letter-spacing:.4px;font-weight:600;border-color:#becbc5;padding-left:15px}
+.tag{font-size:11px;letter-spacing:.15px;background:#e9efea;border:1px solid #d0d9d4;color:#476364;border-radius:3px;padding:8px 11px}
+.live b{background:#39987b;box-shadow:none}
+.mission{padding:22px 29px 18px;border-bottom:1px solid #d3dbd6;align-items:center;gap:24px}
+.eyebrow{font-size:11px;letter-spacing:1px;color:#627674;font-weight:750}
+.mission h1{font-size:clamp(29px,3.0vw,38px);font-weight:720;line-height:1.18;letter-spacing:-1.2px;color:#1D292D;margin:6px 0 7px}
+.mission h1 em{color:#1D292D}
+.sub{font-size:13px;color:#597172;line-height:1.55;max-width:690px}
+.metric-ribbon{border:0;border-left:1px solid #cbd6d0;border-radius:0;min-width:360px;gap:0}
+.metric{background:#F7F7F3;padding:7px 14px;border-right:1px solid #d8e0db;min-width:112px}
+.metric label{color:#637779;font-size:11px;letter-spacing:.2px;font-weight:700}
+.metric strong{font-size:24px;color:#1D292D;font-weight:720}
+.metric small{color:#64797a;font-size:10px}
+.workbench{padding:17px 29px 0;grid-template-columns:minmax(0,1fr) 315px;gap:15px}
+.scene-wrap{border-radius:3px;border:1px solid #415b5f;box-shadow:none;background:#17282d}
+.scene-top{height:55px;padding:0 18px;border-bottom:1px solid #425b60;background:#1D3035}
+.scene-title{font-size:12px;letter-spacing:.5px;color:#EFF3F0;font-weight:800}
+.tiny{font-size:11px;color:#aec2c0}
+.mode{border:1px solid #446066;border-radius:3px;background:#15272c;padding:3px;gap:3px}
+.mode button{font-size:11px;padding:8px 10px;border-radius:2px}
+.mode button.active{background:#dfe9e5;color:#15282d;font-weight:700}
+.viewport{height:510px;background:
+ linear-gradient(90deg,rgba(155,189,182,.035) 1px,transparent 1px),
+ linear-gradient(rgba(155,189,182,.035) 1px,transparent 1px),
+ radial-gradient(ellipse at 50% 65%,#294348,#0f2328 80%);
+ background-size:42px 42px,42px 42px,100% 100%}
+.viewport:after{background:linear-gradient(0deg,#08171999,transparent 13%,transparent 93%,#0c212a55)}
+.factory-plane{transform:none}
+.station{width:clamp(146px,17.4%,202px);height:182px;filter:drop-shadow(0 14px 10px #05131799)}
+.station .platform{height:91px;border-radius:3px;bottom:12px;border:1px solid #779599;background:#2c4a50}
+.station .machine-picture{inset:7px 5px 30px}
+.station .machine-picture svg{width:100%;height:100%}
+.station .badgeid{top:-11px;left:6px;background:#E9F0EA;color:#1A3237;border:0;border-left:4px solid #8AA6A0;border-radius:1px;padding:5px 10px;font-size:11px;letter-spacing:.3px}
+.station.down .badgeid{border-left-color:#FF681B;color:#743518;background:#FFF1E8}
+.station .light{width:8px;height:8px;right:12px;top:12px;box-shadow:none}
+.station.down .light{background:#FF681B;box-shadow:0 0 0 4px #FF681B22}
+.station .status{font-size:10px;letter-spacing:.2px;right:8px;top:26px;background:#0d2830c4;padding:3px 5px}
+.station .machine-name{font-size:11px;bottom:19px;padding:4px 8px;left:7px}
+.station .wip em{height:13px;width:13px}
+.station .wip span{font-size:11px}
+.station.down{animation:none}
+.station.down .platform{box-shadow:0 0 0 2px #FF681B77;background:#513d35}
+.scenario-mark{font-size:11px;letter-spacing:.3px;padding:7px 11px;border-radius:2px;background:#0e2429ee}
+.split-line{box-shadow:none;background:#F7F7F3;width:2px}
+.bottom-scene{font-size:11px;padding:13px 16px;background:#182b30}
+.system-panel{border:1px solid #d5ddd9;border-radius:3px;background:#EFF2EF;color:#1D292D;padding:16px;gap:14px}
+.panel-title,.panel-label{color:#34494b;font-size:12px;letter-spacing:.6px;font-weight:800}
+.alert{background:#fff;border:1px solid #d6dad4;border-left:4px solid #FF681B;border-radius:2px;padding:13px}
+.alert small,.kicker{font-size:10px;color:#637474;letter-spacing:.5px;font-weight:750}
+.alert strong{font-size:19px;color:#1D292D}
+.alert p,.choice p{color:#637474;font-size:12px;line-height:1.45}
+.choice{background:transparent;border:0;border-bottom:1px solid #cbd4ce;padding:0 0 13px;border-radius:0}
+.choice h3{font-size:15px;color:#1D292D;line-height:1.35}
+.statrow{gap:1px;background:#d9e0dc;border:1px solid #d9e0dc}
+.statcell{border-radius:0;background:#F7F7F3;padding:11px 10px}
+.statcell small{font-size:10px;color:#5c7272}
+.statcell strong{font-size:19px;color:#1D292D}
+.statcell.good strong{color:#216c56}
+.divider{background:#d2dad5}
+.warning{border-radius:2px;background:#fff4e9;border-left:3px solid #FF681B;color:#725038;font-size:11px;line-height:1.5;padding:10px}
+.playback{margin:0 29px;padding:17px 0 17px;border-bottom:1px solid #cad4ce;background:transparent}
+.play-head{color:#1D292D;font-size:13px;letter-spacing:.2px}
+.play-head span{color:#546c6b!important;font-size:11px}
+.controls{margin-top:8px}
+.control{border-radius:2px;background:#e5ebe6;color:#263d40;border:1px solid #c1d0c8;font-size:13px;padding:9px 12px}
+.control.main{background:#FF681B;color:#192a2c;border-color:#FF681B}
+.time{font-size:23px;color:#1D292D;font-weight:750;min-width:100px}
+.timeline{accent-color:#FF681B}
+.marker{font-size:10px}
+.lower{padding:0 29px 18px;gap:14px}
+.panel{border-radius:2px;border:1px solid #d6dfd8;background:#FFFFFF;color:#1D292D}
+.sectionbar{background:#F1F4F0;border-bottom:1px solid #D4DED8;padding:15px}
+.sectionbar h2{font-size:12px;letter-spacing:.45px;color:#223a3d}
+.sectionbar span{font-size:11px;color:#6b7f7e}
+.orders{padding:8px 14px}
+.order{background:#fff;border-color:#dae2dc;grid-template-columns:75px minmax(0,1fr) 50px 96px;gap:12px;padding:12px 8px}
+.order:hover,.order.selected{background:#eef4ef}
+.order .id{font-size:13px;color:#1D292D}
+.order .id small{color:#697d7c;font-size:11px}
+.track{background:#e3ebe5;height:7px}
+.track .done{background:#267e67}
+.order .pct{font-size:12px;color:#3b5656}
+.order .deadline{color:#344b4d;font-size:11px}
+.legend{font-size:11px;color:#526967;padding:8px 14px 12px}
+.impact{padding:16px;color:#1D292D}
+.impact p{font-size:13px;line-height:1.6;color:#42595b}
+.delta{background:#edf4f0;border-left:3px solid #267e67;padding:15px;border-radius:0}
+.delta strong{color:#1c6f57;font-size:27px}
+.delta small{color:#506c65;font-size:11px}
+.impact .warning{color:#725038;background:#fff4e9}
+.footer{padding:13px 29px 20px;border-top:1px solid #d2dbd5;background:#f0f2ee;color:#697b79;font-size:10px;letter-spacing:.15px}
+.tooltip{color:#eff4f0}
+@media(max-width:1100px){
+ .mission{flex-wrap:wrap}
+ .metric-ribbon{width:100%;min-width:0}
+ .workbench{grid-template-columns:1fr}
+ .system-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
+ .panel-title{grid-column:1/-1}
+ .viewport{height:490px}
+ .lower{grid-template-columns:1fr}
+}
+@media(max-width:700px){
+ .mast,.mission{padding:13px 16px}
+ .brand-sub{display:none}
+ .mission h1{font-size:26px}
+ .workbench{padding:12px 10px 0;grid-template-columns:1fr}
+ .viewport{height:420px}
+ .station{width:clamp(90px,20%,136px);height:135px}
+ .station .machine-name,.station .status{font-size:9px}
+ .station .platform{height:55px;bottom:7px}
+ .station .machine-picture{inset:6px 2px 19px}
+ .scene-top{padding:0 10px}
+ .scene-title{font-size:10px}
+ .mode button{font-size:9px;padding:7px 5px}
+ .system-panel{grid-template-columns:1fr}
+ .playback{margin:0 12px}
+ .lower{padding:0 10px}
+ .order{grid-template-columns:60px minmax(0,1fr) 45px 66px;gap:6px}
+ .order .deadline{font-size:10px}
+}
+
+
+.order-detail small{display:block;margin-top:7px;font-size:11px;color:#6a7f79}
+.order-detail small b{font-size:11px;color:#28594d;font-weight:700}
